# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
*.egg-info/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local secrets and credentials
.env
*.token
credentials*.json

# Large and generated corpus artifacts (never commit these)
/data/
hindi/data/raw/
hindi/data/interim/
hindi/data/processed/
hindi/data/splits/
hindi/data/checkpoints/
bhojpuri/data/raw/
bhojpuri/data/interim/
bhojpuri/data/processed/
bhojpuri/data/splits/
bhojpuri/data/checkpoints/
*.jsonl
*.jsonl.gz
*.parquet
*.arrow
*.sqlite
*.sqlite3
*.db
*.tokens.bin
*.pt
*.pth
**/runs/

# Generated tokenizer experiments. Final selected .model/.vocab
# files and report figures/tables are intentionally tracked.
**/tokenizer/runs/
tmp/
output/kaggle/
lma_phase2_outputs/

# Compact Phase 2 evidence is intentionally versioned under report/.
!report/runs/
!report/runs/**
!report/samples/
!report/samples/generated/
!report/samples/generated/phase2/
!report/samples/generated/phase2/*.jsonl

# Small Phase 3 development examples are review evidence, not full datasets.
!report/samples/generated/phase3/
!report/samples/generated/phase3/pilot_v1/
!report/samples/generated/phase3/pilot_v1/*_development.jsonl

# Full Phase 3 evaluation predictions are reproducibility evidence.
!report/results/generated/phase3/
!report/results/generated/phase3/pretrained_v1/
!report/results/generated/phase3/pretrained_v1/hindi/
!report/results/generated/phase3/pretrained_v1/bhojpuri/
!report/results/generated/phase3/pretrained_v1/*/*_predictions.jsonl

# Supplemental per-example answer-presence scores.
!report/results/generated/phase3/pretrained_presence_v1/
!report/results/generated/phase3/pretrained_presence_v1/*_presence.jsonl

# Compressed answer-and-explanation predictions for symbolic verification.
!report/results/generated/phase3/pretrained_proof_v1/
!report/results/generated/phase3/pretrained_proof_v1/hindi/
!report/results/generated/phase3/pretrained_proof_v1/bhojpuri/
!report/results/generated/phase3/pretrained_proof_v1/*/*_predictions.jsonl.gz

# Completed, resumable CPU explanation verification run.
!report/results/generated/phase3/pretrained_proof_v2/
!report/results/generated/phase3/pretrained_proof_v2/hindi/
!report/results/generated/phase3/pretrained_proof_v2/bhojpuri/
!report/results/generated/phase3/pretrained_proof_v2/*/*_predictions.jsonl.gz

# Corrected per-example semantic and answer-presence evidence.
!report/results/generated/phase3/semantic_original_v1/
!report/results/generated/phase3/semantic_original_v1/*.jsonl.gz
!report/results/generated/phase3/semantic_explanations_v1/
!report/results/generated/phase3/semantic_explanations_v1/*.jsonl.gz

# Finetuned Phase 3 evaluation predictions and summaries.
!report/results/generated/phase3/finetuned_v1/
!report/results/generated/phase3/finetuned_v1/hindi/
!report/results/generated/phase3/finetuned_v1/bhojpuri/
!report/results/generated/phase3/finetuned_v1/*/*.json
!report/results/generated/phase3/finetuned_v1/*/*/*.jsonl
!report/results/generated/phase3/finetuned_v1/*/*/*_predictions.jsonl.gz

# Compact auxiliary prediction evidence; checkpoints remain outside Git.
!report/results/generated/phase3/optimal_eval/*/*/*_predictions.jsonl.gz

# Retrospective explicit-answer scores preserve the original generation artifacts.
!report/results/generated/phase3/explicit_answer_v1/scores/*.jsonl.gz
